# Copiá este archivo como .env y completá tus datos. El .env nunca se sube a GitHub.

# Opción A: base local (PostgreSQL en tu compu)
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock

# Opción B: base en la nube (Neon). Si está esta línea, se usa en lugar de las de arriba.
# DATABASE_URL=postgresql://usuario:contraseña@servidor/neondb?sslmode=require

# Usuario y contraseña para entrar al sistema
ADMIN_USER=admin
ADMIN_PASSWORD=elegí_una_contraseña_larga

# Clave para firmar las sesiones. Generala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=pegá_acá_la_clave_generada
